<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AutumnOS.OwnedClipboardStationLease.DRAFT</AssemblyName>
    <RootNamespace>AutumnOS.OwnedClipboardStationLease</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Native.cs" />
    <Compile Include="Protocol.cs" />
    <Compile Include="PinnedInputs.cs" />
  </ItemGroup>
</Project>
