<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>派蒙</Authors>
    <Product>AutumnOS owned AppContainer browser feasibility host</Product>
    <Version>0.1.0</Version>
    <BuildId Condition="'$(BuildId)' == ''">appcontainer-browser-host-untracked</BuildId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildId" Value="$(BuildId)" />
    <AssemblyMetadata Include="AcceptanceStatus" Value="mechanism-only-not-product-isolation" />
  </ItemGroup>
</Project>
