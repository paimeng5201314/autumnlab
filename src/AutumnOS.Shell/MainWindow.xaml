<Window
    x:Class="AutumnOS.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl x:Name="InteractionRoot">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
    <Grid.Resources>
      <SolidColorBrush x:Key="DesktopInk" Color="#283C37" />
      <SolidColorBrush x:Key="DesktopMuted" Color="#566C62" />
      <SolidColorBrush x:Key="GlassFill" Color="#A8FFFFFF" />
      <SolidColorBrush x:Key="GlassStroke" Color="#C4FFFFFF" />
      <Style x:Key="SoftButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20,12"/>
      </Style>
      <SolidColorBrush x:Key="SidebarSurface" Color="#EEF0F4"/>
      <SolidColorBrush x:Key="SettingsSurface" Color="#F7F8FA"/>
      <SolidColorBrush x:Key="StoreCardSurface" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="StoreCardStroke" Color="#E3E7E4"/>
      <Style x:Key="SidebarItem" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="52"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch"/>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Grid x:Name="DesktopPanel" Visibility="Collapsed" Background="Transparent" AutomationProperties.AutomationId="DesktopPanel">
      <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
        <Canvas Width="1200" Height="900">
          <Rectangle x:Name="Sky" Width="1200" Height="900"/>
          <Ellipse x:Name="SunHalo" Width="660" Height="660" Canvas.Left="700" Canvas.Top="-230" Opacity="0.35"/>
          <Ellipse x:Name="Sun" Width="350" Height="350" Canvas.Left="846" Canvas.Top="-52" Opacity="0.62"/>
          <Path x:Name="FarHill" Data="M -80,600 C 190,455 425,670 676,524 C 855,420 1040,430 1300,510 L 1300,960 L -80,960 Z"/>
          <Path x:Name="MiddleHill" Data="M -80,778 C 124,400 320,540 554,650 C 830,792 1070,580 1300,640 L 1300,960 L -80,960 Z"/>
          <Path x:Name="NearHill" Data="M -80,880 C 165,708 375,722 584,786 C 816,870 967,662 1300,752 L 1300,960 L -80,960 Z"/>
          <Path Stroke="#55FFFFFF" StrokeThickness="1" Data="M -10,850 C 240,684 410,700 594,762 C 826,840 995,642 1250,730"/>
        </Canvas>
      </Viewbox>
      <Grid Padding="38,22,38,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="✦" FontSize="18" Foreground="{StaticResource DesktopInk}"/>
            <TextBlock Text="LAB CHRONICLES" CharacterSpacing="180" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DesktopInk}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="StatusClock" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DesktopInk}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="NotificationsButton" Content="通知" Click="OnNotifications" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" Foreground="{StaticResource DesktopInk}" CornerRadius="16" Padding="16,6" AutomationProperties.AutomationId="NotificationsButton"/>
            <Button Content="外观" Click="OnAppearance" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" Foreground="{StaticResource DesktopInk}" CornerRadius="16" Padding="16,6" AutomationProperties.AutomationId="AppearanceButton"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="32,68,24,0" VerticalAlignment="Top" ColumnSpacing="28">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="12" MaxWidth="370" HorizontalAlignment="Left">
            <TextBlock Text="A LITTLE SPACE FOR CURIOSITY" CharacterSpacing="200" FontSize="10" Foreground="{StaticResource DesktopMuted}"/>
            <TextBlock x:Name="DesktopTime" FontSize="76" FontWeight="Light" FontFamily="Segoe UI Variable Display" Foreground="{StaticResource DesktopInk}"/>
            <TextBlock x:Name="DesktopDate" FontSize="15" Foreground="{StaticResource DesktopInk}"/>
            <Border Height="1" Width="48" Background="{StaticResource DesktopMuted}" HorizontalAlignment="Left" Margin="0,16,0,8"/>
            <TextBlock Text="把好奇心，&#x0a;留给每一天。" FontSize="26" FontWeight="Light" LineHeight="40" Foreground="{StaticResource DesktopInk}"/>
            <TextBlock x:Name="DesktopAppearance" FontSize="12" Margin="0,12,0,0" Foreground="{StaticResource DesktopMuted}" AutomationProperties.AutomationId="DesktopAppearance"/>
            <StackPanel x:Name="DesktopWidgetContainer" Spacing="8" AutomationProperties.AutomationId="DesktopWidgetContainer"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="20" Margin="0,24,0,0">
            <ScrollViewer x:Name="DesktopAppScroll" MaxHeight="420" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Left">
            <Grid x:Name="AppGrid" ColumnSpacing="12" HorizontalAlignment="Left">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="118"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
            </Grid>
            </ScrollViewer>
            <InfoBar x:Name="DesktopError" IsOpen="False" IsClosable="True" Severity="Error" MaxWidth="400"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,14">
          <TextBlock x:Name="DesktopGestureHint" Text="拖动图标调整位置 · 双击桌面空白处查看后台" FontSize="12" Foreground="{StaticResource DesktopMuted}" HorizontalAlignment="Center" AutomationProperties.AutomationId="DesktopGestureHint"/>
          <Ellipse Width="5" Height="5" Fill="{StaticResource DesktopInk}" Opacity="0.65"/>
          <Border Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" CornerRadius="30" Padding="18,12">
            <StackPanel x:Name="Dock" Orientation="Horizontal" Spacing="18"/>
          </Border>
        </StackPanel>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="DesktopBrand" Text="AutumnOS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DesktopInk}"/>
          <TextBlock x:Name="DesktopProducer" Grid.Column="1" FontSize="12" Foreground="{StaticResource DesktopInk}" AutomationProperties.AutomationId="DesktopProducer"/>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="{StaticResource SettingsSurface}" AutomationProperties.AutomationId="SettingsPanel">
      <Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarSurface}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Padding="20,20,20,30" Spacing="12">
            <Button Content="‹  桌面" Click="OnBackground" Background="Transparent" BorderThickness="0" Padding="8,8" AutomationProperties.AutomationId="SettingsHomeButton"/>
            <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" Margin="8,6,0,18"/>
            <TextBlock Text="外观与桌面" FontSize="11" Opacity="0.6" Margin="12,0,0,0"/>
            <StackPanel Spacing="3">
              <ToggleButton x:Name="NavAppearance" Tag="appearance" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavAppearance" AutomationProperties.Name="外观">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#748AA6"><FontIcon Glyph="&#xE790;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="外观" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
              <ToggleButton x:Name="NavDesktop" Tag="desktop" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavDesktop" AutomationProperties.Name="桌面与 Dock">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#8C80A8"><FontIcon Glyph="&#xE80F;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="桌面与 Dock" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
            </StackPanel>
            <TextBlock Text="系统" FontSize="11" Opacity="0.6" Margin="12,22,0,0"/>
            <StackPanel Spacing="3">
              <ToggleButton x:Name="NavAccount" Tag="account" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavAccount" AutomationProperties.Name="账号">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#658B9B"><FontIcon Glyph="&#xE77B;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="账号" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
              <ToggleButton x:Name="NavPermissions" Tag="permissions" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavPermissions" AutomationProperties.Name="应用权限与数据">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#A48B68"><FontIcon Glyph="&#xE72E;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="应用权限与数据" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
              <ToggleButton x:Name="NavNotifications" Tag="notifications" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavNotifications" AutomationProperties.Name="通知与控制中心">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#B9747C"><FontIcon Glyph="&#xE7F4;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="通知与控制中心" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
              <ToggleButton x:Name="NavGitHub" Tag="github" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavGitHub" AutomationProperties.Name="GitHub 加速">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#617F9E"><FontIcon Glyph="&#xE774;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="GitHub 加速" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
              <ToggleButton x:Name="NavUpdates" Tag="updates" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavUpdates" AutomationProperties.Name="系统更新"><TextBlock Text="↻   系统更新"/></ToggleButton>
              <ToggleButton x:Name="NavAbout" Tag="about" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavAbout" AutomationProperties.Name="关于">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#728C9F"><FontIcon Glyph="&#xE946;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="关于" VerticalAlignment="Center" FontSize="15"/></Grid>
              </ToggleButton>
            </StackPanel>
            <TextBlock Text="高级" FontSize="11" Opacity="0.6" Margin="12,22,0,0"/>
            <ToggleButton x:Name="NavDiagnostics" Tag="diagnostics" Click="OnSettingsCategory" Style="{StaticResource SidebarItem}" AutomationProperties.AutomationId="SettingsNavDiagnostics" AutomationProperties.Name="开发者诊断">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#758D7E"><FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="White"/></Border><TextBlock Grid.Column="1" Text="开发者诊断" VerticalAlignment="Center" FontSize="15"/></Grid>
            </ToggleButton>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="32,32,28,22">
          <TextBlock x:Name="SettingsDetailTitle" Text="外观" FontSize="28" FontWeight="SemiBold" AutomationProperties.AutomationId="SettingsDetailTitle"/>
        </Border>
        <Grid Grid.Row="1">
          <ScrollViewer x:Name="GitHubDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="GitHubContent" Padding="28,24,28,32" Spacing="18"/></ScrollViewer>
          <ScrollViewer x:Name="UpdateDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="UpdateContent" Padding="28,24,28,32" Spacing="18"/></ScrollViewer>
          <ScrollViewer x:Name="AccountDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="AccountContent" Padding="28,24,28,32" Spacing="18"/></ScrollViewer>
          <ScrollViewer x:Name="PermissionsDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="PermissionsContent" Padding="28,24,28,32" Spacing="18"/></ScrollViewer>
          <ScrollViewer x:Name="AppearanceDetails" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="28,24,28,32" Spacing="22" MaxWidth="900">
              <TextBlock Text="选择一种光线，再换一片风景。" Opacity="0.65" FontSize="15"/>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="26">
            <StackPanel Spacing="18"><TextBlock Text="外观" FontSize="19" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="LightButton" Content="☀  浅色" Tag="light" Click="OnTheme" Style="{StaticResource SoftButton}" AutomationProperties.AutomationId="LightThemeButton"/>
                <Button x:Name="DarkButton" Content="☾  深色" Tag="dark" Click="OnTheme" Style="{StaticResource SoftButton}" AutomationProperties.AutomationId="DarkThemeButton"/>
                <Button x:Name="SystemButton" Content="跟随系统" Tag="system" Click="OnTheme" Style="{StaticResource SoftButton}" AutomationProperties.AutomationId="SystemThemeButton"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="26">
            <StackPanel Spacing="18"><TextBlock Text="壁纸" FontSize="19" FontWeight="SemiBold"/>
              <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="WarmButton" Tag="warm" Click="OnWallpaper" HorizontalAlignment="Stretch" Padding="0" CornerRadius="18" AutomationProperties.AutomationId="WarmWallpaperButton"><StackPanel><Border Height="98" CornerRadius="17,17,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2DEC2"/><GradientStop Color="#BD7958" Offset="0.55"/><GradientStop Color="#4C6B57" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="晨光" Margin="18,12"/></StackPanel></Button>
                <Button x:Name="MistButton" Grid.Column="1" Tag="mist" Click="OnWallpaper" HorizontalAlignment="Stretch" Padding="0" CornerRadius="18" AutomationProperties.AutomationId="MistWallpaperButton"><StackPanel><Border Height="98" CornerRadius="17,17,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D1E8DC"/><GradientStop Color="#8DAEAA" Offset="0.55"/><GradientStop Color="#3D6866" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="山雾" Margin="18,12"/></StackPanel></Button>
                <Button x:Name="NightButton" Grid.Column="2" Tag="night" Click="OnWallpaper" HorizontalAlignment="Stretch" Padding="0" CornerRadius="18" AutomationProperties.AutomationId="NightWallpaperButton"><StackPanel><Border Height="98" CornerRadius="17,17,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BBB8D4"/><GradientStop Color="#797299" Offset="0.55"/><GradientStop Color="#333C5A" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="暮色" Margin="18,12"/></StackPanel></Button>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock x:Name="PreferencesStatus" TextWrapping="Wrap" Opacity="0.75" AutomationProperties.AutomationId="PreferencesStatus"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="DesktopDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="28,24" Spacing="24">
              <TextBlock Text="你的桌面" FontSize="20" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24"><StackPanel Spacing="12"><TextBlock Text="应用" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="DesktopApplicationsSummary" TextWrapping="Wrap" LineHeight="26" AutomationProperties.AutomationId="DesktopApplicationsSummary"/></StackPanel></Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Dock" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="DockApplicationsSummary" TextWrapping="Wrap" LineHeight="26"/></StackPanel></Border>
              <TextBlock Text="拖动桌面图标可调整三列网格中的顺序，也可通过长按、右键或 Shift+F10 菜单选择向前移动／向后移动；位置保存后会在下次启动时保留。单击图标可打开或继续应用，双击桌面空白处或按 F6 可查看正在运行的应用并选择继续／结束。文件夹、多桌面、完整搜索、自定义 Dock 和抖动编辑尚未提供；拖动到边缘不会自动滚动。" TextWrapping="Wrap" Opacity="0.65" LineHeight="24"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="NotificationsDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="28,24" Spacing="22">
              <StackPanel x:Name="NotificationContent" Spacing="14"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24"><StackPanel Spacing="12"><TextBlock Text="控制中心" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="系统音量、网络等控制尚未接入，当前没有可调整项目。" TextWrapping="Wrap" LineHeight="26" Opacity="0.7"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
    <ScrollViewer x:Name="FoundationPanel" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
      <Grid MaxWidth="1000" Padding="28,24" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock Text="LAB CHRONICLES" CharacterSpacing="220" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="ProductTitle" FontSize="26" FontWeight="SemiBold" AutomationProperties.AutomationId="ProductTitle" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="DiagnosticSampleButton" Content="打开元素配对" Click="OnSample" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="DiagnosticSampleButton" />
            <Button Content="关于 AutumnOS" Click="OnAbout" AutomationProperties.AutomationId="AboutButton" />
            <TextBlock x:Name="SessionSummary" Text="无游戏会话" FontSize="12" AutomationProperties.AutomationId="SessionSummary" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
          <StackPanel Spacing="18">
            <TextBlock Text="本地数据空间" FontSize="20" FontFamily="Segoe UI Variable Display" FontWeight="Light" />
            <TextBlock Text="启动与数据记录" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ProducerText" FontSize="16" AutomationProperties.AutomationId="ProducerCredit" />
            <TextBlock Text="本地开发版 · 内部应用验证" FontSize="13" Opacity="0.7" />
              <ToggleSwitch x:Name="DeveloperModeToggle" Header="开发者模式" Toggled="OnDeveloperModeChanged" AutomationProperties.AutomationId="DeveloperModeToggle"/>
              <StackPanel x:Name="RecoveryContent" Spacing="8"/>
              <Button x:Name="SupportExportButton" Content="导出脱敏诊断包" Click="OnExportSupportBundle" AutomationProperties.AutomationId="SupportExportButton"/>
              <TextBlock x:Name="SupportExportStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="SupportExportStatus"/>
              <TextBlock x:Name="DiagnosticLogStatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticLogStatusText"/>
            <TextBlock Text="此处检查实际程序旁的数据目录与首启记录；已有应用和存档会保留。" TextWrapping="Wrap" FontSize="16" MaxWidth="690" HorizontalAlignment="Left" />
            <InfoBar x:Name="DataStatus" IsOpen="True" IsClosable="False" Title="正在检查本地数据空间" />
            <TextBlock x:Name="DataPath" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="InitializeButton" Content="完成基础初始化" Click="OnInitialize" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="InitializeButton" />
              <Button Content="重新检查" Click="OnRetry" AutomationProperties.AutomationId="RetryButton" />
            </StackPanel>
            <TextBlock x:Name="CheckpointText" TextWrapping="Wrap" AutomationProperties.AutomationId="CheckpointText" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18" Padding="24">
          <StackPanel Spacing="12">
            <TextBlock Text="账户连接准备" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ConfigurationText" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigurationText" />
            <TextBlock x:Name="RegistrationText" TextWrapping="Wrap" Opacity="0.75" />
            <Button x:Name="DiscoveryButton" Content="检测公开发现地址" Click="OnDiscovery" AutomationProperties.AutomationId="DiscoveryButton" />
            <TextBlock x:Name="DiscoveryText" TextWrapping="Wrap" AutomationProperties.AutomationId="DiscoveryText" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
          </Grid>
          <ScrollViewer x:Name="AboutDetails" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="28,30" Spacing="22">
              <StackPanel Spacing="12" Margin="0,12,0,16"><TextBlock Text="✦" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="AboutProductName" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutProductName"/><TextBlock x:Name="AboutProducer" FontSize="16" AutomationProperties.AutomationId="AboutProducer"/></StackPanel>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24"><StackPanel Spacing="18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="版本" Opacity="0.65"/><TextBlock x:Name="AboutVersion" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.AutomationId="AboutVersion"/></Grid>
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Spacing="6"><TextBlock Text="本地构建" Opacity="0.65"/><TextBlock x:Name="AboutBuild" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="AboutBuild"/></StackPanel>
              </StackPanel></Border>
              <TextBlock Text="本地开发检查版 · 未公开发行" Opacity="0.65"/>
              <TextBlock Text="C# / .NET 10 · WinUI 3" Opacity="0.65"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="StorePanel" Visibility="Collapsed" Background="{StaticResource SettingsSurface}" AutomationProperties.AutomationId="StorePanel" />
    <Grid x:Name="ManagedAppPanel" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AutomationProperties.AutomationId="ManagedAppPanel" />
    <Grid x:Name="AppPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="20,12" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="‹  返回桌面" Click="OnBackground" AutomationProperties.AutomationId="BackgroundButton"/>
        <StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="GameTitle" Text="元素配对" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="RuntimeStatus" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="RuntimeStatus"/></StackPanel>
        <Button Grid.Column="2" Content="结束游戏" Click="OnCloseGame" AutomationProperties.AutomationId="CloseGameButton"/>
      </Grid>
      <Grid x:Name="GameContent" Grid.Row="1"/>
    </Grid>
    <Grid x:Name="DeveloperPanel" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AutomationProperties.AutomationId="DeveloperPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="24,14" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="返回桌面" Click="OnBackground" AutomationProperties.AutomationId="DeveloperHome"/><TextBlock Grid.Column="1" Text="开发者工具" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
      <Border Grid.Row="1" Margin="20,0,20,12" Padding="12,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock x:Name="DeveloperSimulationBanner" Text="开发预览模拟：无运行预览。" TextWrapping="Wrap" FontSize="13" AutomationProperties.AutomationId="DeveloperSimulationBanner"/></Border>
      <Grid Grid.Row="2" ColumnSpacing="16" Padding="20,0,20,20"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="DeveloperContent" Spacing="14"/></ScrollViewer>
        <Grid x:Name="DeveloperPreviewContent" Grid.Column="1" AutomationProperties.AutomationId="DeveloperPreviewContent"/>
      </Grid>
    </Grid>
    <Grid x:Name="WelcomePanel" Background="#F2EEE5" AutomationProperties.AutomationId="WelcomePanel">
      <Ellipse Width="650" Height="650" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-230,-350" Fill="#E2E6D7" IsHitTestVisible="False"/>
      <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-200,0,0" Fill="#EDDBC9" IsHitTestVisible="False"/>
      <TextBlock Text="LAB CHRONICLES" CharacterSpacing="300" FontSize="11" Foreground="#4D675C" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"/>
      <StackPanel x:Name="HelloStage" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
        <TextBlock Text="hello" FontFamily="Segoe Print" FontSize="110" FontWeight="Light" Foreground="#355748" HorizontalAlignment="Center" AutomationProperties.AutomationId="HelloTitle"/>
        <TextBlock Text="欢迎来到你的探索空间。" FontSize="20" Foreground="#607568" HorizontalAlignment="Center"/>
        <Button Content="开始探索  →" Click="OnWelcomeNext" Tag="brand" HorizontalAlignment="Center" Margin="0,28,0,0" Padding="28,14" CornerRadius="24" Background="#355748" Foreground="White" AutomationProperties.AutomationId="HelloNextButton"/>
      </StackPanel>
      <StackPanel x:Name="BrandStage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
        <TextBlock Text="✦" FontSize="56" Foreground="#6E8462" HorizontalAlignment="Center"/>
        <TextBlock x:Name="WelcomeBrand" FontSize="60" FontWeight="Light" Foreground="#2E483C" HorizontalAlignment="Center" AutomationProperties.AutomationId="WelcomeBrand"/>
        <TextBlock x:Name="WelcomeFullBrand" FontSize="16" Foreground="#607568" HorizontalAlignment="Center"/>
        <TextBlock x:Name="WelcomeProducer" FontSize="13" Foreground="#607568" HorizontalAlignment="Center"/>
        <Button Content="继续  →" Click="OnWelcomeNext" Tag="initializing" HorizontalAlignment="Center" Margin="0,32,0,0" Padding="28,14" CornerRadius="24" Background="#355748" Foreground="White" AutomationProperties.AutomationId="BrandNextButton"/>
      </StackPanel>
      <StackPanel x:Name="InitializeStage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Spacing="18" Padding="32">
        <TextBlock Text="从这里，开始。" FontSize="42" Foreground="#2E483C" HorizontalAlignment="Center"/>
        <TextBlock Text="准备桌面与元素配对，让灵感有处可留。&#x0a;游戏进度保存在这台电脑上，无需登录也能开始。" FontSize="17" Foreground="#607568" TextWrapping="Wrap" TextAlignment="Center" LineHeight="28"/>
        <TextBlock Text="选择你喜欢的光线" FontSize="13" Margin="0,18,0,0" Foreground="#607568" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"><Button x:Name="WelcomeLightButton" Content="☀  浅色" Tag="light" Click="OnTheme" Padding="22,12" CornerRadius="18"/><Button x:Name="WelcomeDarkButton" Content="☾  深色" Tag="dark" Click="OnTheme" Padding="22,12" CornerRadius="18"/></StackPanel>
        <TextBlock x:Name="WelcomeTheme" Foreground="#607568" HorizontalAlignment="Center"/>
        <Button x:Name="PrepareDesktopButton" Content="准备我的桌面  →" Click="OnInitialize" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="28,14" CornerRadius="24" Background="#355748" Foreground="White" AutomationProperties.AutomationId="PrepareDesktopButton"/>
        <ProgressRing x:Name="InitializeProgress" IsActive="False" Visibility="Collapsed" Width="24" Height="24"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30" Spacing="10"><TextBlock x:Name="WelcomeError" TextWrapping="Wrap" Foreground="#9D3425" MaxWidth="680"/><Button x:Name="WelcomeRetry" Content="重新检查" Click="OnRetry" Visibility="Collapsed" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
    <Grid x:Name="RunningSwitcher" Visibility="Collapsed" Background="#C51B2422" AutomationProperties.AutomationId="RunningSwitcher">
      <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TabIndex="2" Click="OnDismissSwitcher" AutomationProperties.AutomationId="RunningSwitcherBackdrop" AutomationProperties.Name="返回桌面"/>
      <Border x:Name="SwitcherSurface" Margin="40,50" MaxWidth="1100" CornerRadius="30" Background="{StaticResource SettingsSurface}" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <Grid RowSpacing="22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="正在运行" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="RunningSwitcherTitle"/><TextBlock x:Name="SwitcherSummary" Text="" Opacity="0.65" TextWrapping="Wrap" AutomationProperties.AutomationId="RunningSwitcherSummary"/></StackPanel>
            <Button x:Name="SwitcherClose" Grid.Column="1" Content="完成" Click="OnDismissSwitcher" CornerRadius="18" Padding="20,10" VerticalAlignment="Top" AutomationProperties.AutomationId="RunningSwitcherClose"/>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" MaxHeight="450">
            <StackPanel x:Name="RunningCards" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Padding="2,4,2,12"/>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="选择卡片继续 · 结束前记得保存 · Esc 返回桌面" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </UserControl>
</Window>



