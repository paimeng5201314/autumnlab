<Project>
  <Import Project="$(MSBuildThisFileDirectory)build/Brand.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>$(AutumnProductName)</Product>
    <Authors>$(AutumnProducer)</Authors>
    <Description>$(AutumnProducerCredit)</Description>
    <Version>$(AutumnVersion)</Version>
    <InformationalVersion>$(AutumnReleaseLabel)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>$(AutumnFileVersion)</AssemblyVersion>
    <FileVersion>$(AutumnFileVersion)</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BuildId Condition="'$(BuildId)' == ''">v$(AutumnVersion)-$([System.DateTime]::Now.ToString('yyyyMMdd'))</BuildId>
    <SourceSnapshotId Condition="'$(SourceSnapshotId)' == ''">not_recorded</SourceSnapshotId>
    <AutumnPlatformAcceptance Condition="'$(AutumnPlatformAcceptance)' == ''">false</AutumnPlatformAcceptance>
    <DefineConstants Condition="'$(AutumnPlatformAcceptance)' == 'true'">$(DefineConstants);AUTUMN_PLATFORM_ACCEPTANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DisplayName" Value="$(AutumnDisplayName)" />
    <AssemblyMetadata Include="ProducerCredit" Value="$(AutumnProducerCredit)" />
    <AssemblyMetadata Include="BuildId" Value="$(BuildId)" />
    <AssemblyMetadata Include="SourceSnapshotId" Value="$(SourceSnapshotId)" />
    <AssemblyMetadata Include="SemanticVersion" Value="$(AutumnVersion)" />
    <AssemblyMetadata Include="UpdateSequence" Value="$(AutumnUpdateSequence)" />
    <AssemblyMetadata Include="SecuritySequence" Value="$(AutumnSecuritySequence)" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(AutumnChannel)" />
    <AssemblyMetadata Include="TemporaryPlatformAcceptance" Value="$(AutumnPlatformAcceptance)" />
  </ItemGroup>
</Project>
