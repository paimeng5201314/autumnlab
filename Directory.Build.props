<Project>
  <Import Project="$(MSBuildThisFileDirectory)build/Brand.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>$(AutumnProductName)</Product>
    <Authors>$(AutumnProducer)</Authors>
    <Description>$(AutumnProducerCredit)</Description>
    <Version>$(AutumnVersion)</Version>
    <AutumnReleaseLabel Condition="'$(AutumnReleaseLabel)' == ''">$(AutumnVersion)</AutumnReleaseLabel>
    <InformationalVersion>$(AutumnReleaseLabel)</InformationalVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BuildId Condition="'$(BuildId)' == ''">local-untracked</BuildId>
    <SourceSnapshotId Condition="'$(SourceSnapshotId)' == ''">not_recorded</SourceSnapshotId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DisplayName" Value="$(AutumnDisplayName)" />
    <AssemblyMetadata Include="ProducerCredit" Value="$(AutumnProducerCredit)" />
    <AssemblyMetadata Include="BuildId" Value="$(BuildId)" />
    <AssemblyMetadata Include="SourceSnapshotId" Value="$(SourceSnapshotId)" />
    <AssemblyMetadata Include="SemanticVersion" Value="$(AutumnVersion)" />
  </ItemGroup>
</Project>
